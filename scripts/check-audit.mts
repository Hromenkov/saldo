// Перевірка аудиту до копійки. Запуск: npm test
import { audit, auditBank, auditDoc, auditDuplicates, kop } from '../src/audit/index';
import { BANK, DOCS, type Doc } from '../src/data';

let fails = 0;
const ok = (cond: boolean, msg: string) => { if (!cond) { fails++; console.log('✗ ' + msg); } else console.log('✓ ' + msg); };
const today = new Date('2026-11-30T12:00:00');
const D = (p: Partial<Doc>): Doc => ({
  id: 100, type: 'Прибуткова накладна', no: '1', cp: 'ТОВ «Тест»', date: '03.11', sum: 1200, vat: 200, st: 'ok', src: 'Фото', conf: 99,
  kind: 'purchase_goods', lines: [['281', '631', 1000, ''], ['6441', '631', 200, '']], ...p
});
const errs = (d: Doc) => auditDoc(d, { today }).filter(f => f.sev === 'error');

ok(kop(0.1 + 0.2) === 30 && kop(1645.065) === 164507 && kop(-12.345) === -1235, 'Копійки: 0,1+0,2 = 30 коп., половина копійки — вгору');

// демо-дані складені правильно: аудит не має знаходити помилок
const demo = audit(DOCS, BANK, { today });
ok(demo.errors === 0, `Демо-документи без помилок (знайдено: ${demo.findings.filter(f => f.sev === 'error').map(f => f.t).join('; ') || 'нічого'})`);
ok(demo.findings.some(f => f.area === 'bank' && /Петренко/.test(f.t)), 'Демо: нерознесене надходження від Петренко О. М. помічено');

ok(errs(D({})).length === 0, 'Правильна накладна 1000 + 200 = 1200: помилок немає');

// рядки: кількість × ціна
let f = errs(D({ items: [{ name: 'Цукор', qty: 10, price: 45.5, amount: 455.1, unit: 'кг' }, { name: 'Борошно', qty: 1, price: 544.9, amount: 544.9, unit: 'шт' }], sum: 1200, vat: 200 }));
ok(f.some(x => x.area === 'arith' && /Рядок 1/.test(x.t) && x.diff === 0.1), 'Рядок 10 × 45,50 = 455,00, а написано 455,10: помилка на 0,10 ₴');
f = errs(D({ items: [{ name: 'Сир', qty: 1.235, price: 312.4, amount: 385.81, unit: 'кг' }], sum: 462.97, vat: 77.16, lines: [['281', '631', 385.81, ''], ['6441', '631', 77.16, '']] }));
ok(!f.some(x => x.area === 'arith' && /Рядок/.test(x.t)), 'Дробова кількість 1,235 × 312,40 = 385,814: 385,81 — це округлення, не помилка');
f = errs(D({ items: [{ name: 'А', qty: 2, price: 250, amount: 500, unit: null }, { name: 'Б', qty: 1, price: 499.97, amount: 499.97, unit: null }] }));
ok(f.some(x => x.area === 'arith' && /Сума рядків 999,97/.test(x.t) && x.diff === 0.03), 'Сума рядків 999,97 ≠ 1000,00 без ПДВ: розбіжність 0,03 ₴');

// ПДВ
f = errs(D({ sum: 1200.02, vat: 200.02, lines: [['281', '631', 1000, ''], ['6441', '631', 200.02, '']] }));
ok(f.some(x => x.area === 'vat' && x.diff === 0.02), 'ПДВ 200,02 при 20% від 1000,00 = 200,00: помилка на 0,02 ₴');
f = errs(D({ sum: 1070, vat: 70, lines: [['281', '631', 1000, ''], ['6441', '631', 70, '']] }));
ok(!f.some(x => x.area === 'vat'), 'ПДВ 7% (70 від 1000) визнається');
f = errs(D({ sum: 1300, vat: 300, lines: [['281', '631', 1000, ''], ['6441', '631', 300, '']] }));
ok(f.some(x => x.area === 'vat' && /жодній ставці/.test(x.t)), 'ПДВ 300 від 1000: не відповідає жодній ставці');
// порядкове округлення: 3 рядки по 0,33 → ПДВ 0,07 на кожен = 0,21; на весь документ 0,99 × 20% = 0,20. Обидва варіанти законні
f = errs(D({ items: [0, 1, 2].map(() => ({ name: 'Х', qty: 1, price: 0.33, amount: 0.33, unit: null })), sum: 1.2, vat: 0.21, lines: [['281', '631', 0.99, ''], ['6441', '631', 0.21, '']] }));
ok(!f.some(x => x.area === 'vat'), 'ПДВ, округлений порядково (0,21 замість 0,20), не помилка');

// проводки
f = errs(D({ lines: [['281', '631', 1000, ''], ['6441', '631', 199.99, '']] }));
ok(f.some(x => x.area === 'post' && /розрахунки 1 199,99/.test(x.t)) && f.some(x => x.area === 'post' && /ПДВ у проводках 199,99/.test(x.t)), 'Проводки на 1199,99 при документі на 1200,00: дві помилки');
f = errs(D({ lines: [['281', '631', 1000, ''], ['6441', '631', 200, ''], ['999', '631', 0, '']] }));
ok(f.some(x => x.area === 'post' && /999/.test(x.t)), 'Рахунок 999 не з плану рахунків');
f = errs(D({ kind: 'sale', type: 'Видаткова накладна', lines: [['361', '702', 1200, ''], ['702', '6412', 200, '']] }));
ok(f.length === 0, 'Видаткова: Дт 361 = 1200, Кт 6412 = 200 — правильно');

// реквізити і дата
ok(errs(D({ edrpou: '32855961' })).length === 0 && errs(D({ edrpou: '32855962' })).some(x => x.area === 'req'), 'ЄДРПОУ: вірний проходить, з помилкою в цифрі — ні');
ok(auditDoc(D({ date: '03.12' }), { today }).some(x => x.area === 'date' && x.sev === 'error'), 'Дата в майбутньому');
ok(auditDoc(D({ date: '31.10' }), { today, closedThrough: '2026-10-31' }).some(x => x.area === 'date' && x.sev === 'warn'), 'Документ у закритому періоді');

// дублікати
const a = D({ id: 1, src: 'Фото' }), b = D({ id: 2, src: '1С' });
ok(auditDuplicates([a, b]).some(x => x.sev === 'error' && x.docId === 2 && x.diff === 1200), 'Та сама накладна з фото і з 1С: дублікат на 1200 ₴');
ok(auditDuplicates([a, D({ id: 3, no: '2' })]).some(x => x.sev === 'warn'), 'Той самий контрагент, день і сума, інший номер: можливо, двічі');
ok(auditDuplicates([a, D({ id: 4, no: '1', date: '04.11' })]).length === 0, 'Той самий номер в інший день — не дублікат');

// банк
const doc = D({ id: 7, no: '418', kind: 'sale', cp: 'ТОВ «Агроресурс»', sum: 48600, vat: 8100 });
f = auditBank([doc], [{ d: '05.11', cp: 'ТОВ «Агроресурс»', p: 'Оплата згідно рах. 418', s: 48599.9, dt: '311', kt: '361', st: 'ok' }]);
ok(f.some(x => x.sev === 'error' && /недоплата 0,10/.test(x.t)), 'Оплата 48 599,90 за накладну на 48 600,00: недоплата 0,10 ₴');
f = auditBank([doc], [{ d: '05.11', cp: 'ТОВ «Нова»', p: 'Оплата за товар', s: -5000, dt: '631', kt: '311', st: 'ok' }]);
ok(f.some(x => /первинного документа немає/.test(x.t)), 'Оплата постачальнику без жодного документа');

const r = audit([a, b], [], { today });
ok(r.errors === 1 && r.atStake === 1200 && r.clean === 1, 'Звіт: 1 помилка, під ризиком 1200 ₴, чистий 1 документ із 2');

if (fails) { console.log(`\n${fails} перевірок не пройдено`); process.exit(1); }
console.log('\nАудит: усі перевірки пройдено');
